# SpeakWise AI — Environment Variables Template
# Copy this file to .env and fill in your real keys.
# NEVER commit your actual .env file or API keys to version control.

# ─────────────────────────────────────────────
# Google Gemini API Key (Required for live AI)
# ─────────────────────────────────────────────
# Get a FREE key at: https://aistudio.google.com/apikey
# Free tier limits (no credit card needed):
#   • 15 requests per minute (RPM)
#   • 1 500 requests per day (RPD)
#   • 1 million tokens per day
# Model used: gemini-2.0-flash (falls back to gemini-1.5-flash)
GEMINI_API_KEY=your_google_ai_studio_key_here

# ─────────────────────────────────────────────
# Server settings (optional)
# ─────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
