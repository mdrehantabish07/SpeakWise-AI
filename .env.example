# SpeakWise AI - Environment Variables Template
# Copy this file to .env and insert your real tokens.
# NEVER commit your actual .env file or API keys to version control.

# Hugging Face User Access Token (Required for live AI conversation)
# Get your token from: https://huggingface.co/settings/tokens
# For Aya Expanse or other Inference Providers, ensure your account has active inference credits:
# https://huggingface.co/settings/billing
HF_TOKEN=your_huggingface_token_here

# Backend host and port (optional defaults: 0.0.0.0 and 8000)
PORT=8000
HOST=0.0.0.0
